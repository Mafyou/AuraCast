<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AuraCast.Mobile"
             xmlns:controls="clr-namespace:AuraCast.Mobile.Controls"
             xmlns:strings="clr-namespace:AuraCast.Mobile.Resources.Strings"
             x:Class="AuraCast.Mobile.TutorialPage"
             BackgroundColor="{StaticResource MatrixBackground}">

    <Grid>
        <controls:MatrixRainView Opacity="0.25" />

        <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="20,16,20,28" RowSpacing="16">

            <Button Text="{x:Static strings:AppStrings.TutorialSkip}"
                    Style="{StaticResource MatrixGhostButton}"
                    HorizontalOptions="End"
                    Clicked="OnDoneClicked" />

            <CarouselView x:Name="Steps"
                          Grid.Row="1"
                          Loop="False"
                          IndicatorView="Indicators"
                          PositionChanged="OnPositionChanged">
                <CarouselView.ItemTemplate>
                    <DataTemplate x:DataType="local:TutorialStep">
                        <Border Style="{DynamicResource MatrixPanelBorder}" VerticalOptions="Center" Margin="4,0">
                            <VerticalStackLayout Spacing="18">
                                <Label Text="{Binding Emoji}"
                                       FontSize="56"
                                       HorizontalOptions="Center" />
                                <Label Text="{Binding Title}"
                                       Style="{DynamicResource MatrixTitle}"
                                       FontSize="24" />
                                <Label Text="{Binding Text}"
                                       Style="{DynamicResource MatrixBody}"
                                       FontSize="17"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>

            <IndicatorView x:Name="Indicators"
                           Grid.Row="2"
                           HorizontalOptions="Center"
                           IndicatorColor="{StaticResource MatrixGreenDim}"
                           SelectedIndicatorColor="{StaticResource MatrixGreen}"
                           IndicatorSize="9" />

            <Button x:Name="NextButton"
                    Grid.Row="3"
                    Text="{x:Static strings:AppStrings.TutorialNext}"
                    Style="{StaticResource MatrixPrimaryButton}"
                    Clicked="OnNextClicked" />
        </Grid>
    </Grid>

</ContentPage>
