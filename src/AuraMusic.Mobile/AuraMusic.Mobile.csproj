<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android only: playback capture is an Android 10+ API, and both phones are Android. -->
		<TargetFrameworks>net11.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>AuraMusic.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>AuraMusic</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>fr.mafyou.auramusic</ApplicationId>

		<!--
			Versions. The display version is the one released: raise it here, and the release workflow tags and
			publishes exactly that number. The version code Android and the Play Store compare follows from it
			(1.7.7 gives 10707), so it grows with every release, wherever the build is made.
		-->
		<ApplicationDisplayVersion>1.7.7</ApplicationDisplayVersion>
		<VersionMajor>$([System.Version]::Parse('$(ApplicationDisplayVersion)').Major)</VersionMajor>
		<VersionMinor>$([System.Version]::Parse('$(ApplicationDisplayVersion)').Minor)</VersionMinor>
		<VersionPatch>$([System.Version]::Parse('$(ApplicationDisplayVersion)').Build)</VersionPatch>
		<ApplicationVersion>$([MSBuild]::Add($([MSBuild]::Add($([MSBuild]::Multiply($(VersionMajor), 10000)), $([MSBuild]::Multiply($(VersionMinor), 100)))), $(VersionPatch)))</ApplicationVersion>

		<!--
			Where this build goes: GitHub (an APK that updates itself from the releases) or Play (an AAB the Play
			Store updates, which forbids an app that installs packages). Build the latter with -p:Distribution=Play.
		-->
		<Distribution Condition="'$(Distribution)' == ''">GitHub</Distribution>
		<DefineConstants Condition="'$(Distribution)' == 'Play'">$(DefineConstants);PLAY_STORE</DefineConstants>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion>29.0</SupportedOSPlatformVersion>

		<!-- We deploy to two phones in turn: fast deployment only pushes what changed since the last
		     deploy, whichever phone that was, and leaves the other one running stale code. -->
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<!-- The logo sits on its own dark green, scaled so the outer phones stay inside round launcher masks. -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.png" ForegroundScale="0.62" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#000C08" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\splash_screen.png" BaseSize="384,400" />
		<MauiImage Update="Resources\Images\rain_far.png" BaseSize="360,800" />
		<MauiImage Update="Resources\Images\rain_near.png" BaseSize="360,800" />
		<MauiImage Update="Resources\Images\spectrum_stencil.png" BaseSize="368,120" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0-rc.1.26425.128" />
		<PackageReference Include="OpusSharp.Natives" Version="1.6.1.4" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\AuraMusic.Kernel\AuraMusic.Kernel.csproj" />
	</ItemGroup>


	<ItemGroup>
		<EmbeddedResource Update="Resources\Strings\AppStrings.resx" StronglyTypedLanguage="CSharp" StronglyTypedNamespace="AuraMusic.Mobile.Resources.Strings" StronglyTypedClassName="AppStrings" StronglyTypedFileName="$(IntermediateOutputPath)AppStrings.Designer.cs" />
	</ItemGroup>
</Project>
