<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AuraMusic.Mobile"
             xmlns:controls="clr-namespace:AuraMusic.Mobile.Controls"
             xmlns:strings="clr-namespace:AuraMusic.Mobile.Resources.Strings"
             x:Class="AuraMusic.Mobile.TutorialPage">

    <Grid>
        <controls:MatrixRainView Opacity="0.25" />

        <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="20,16,20,28" RowSpacing="16">

            <Button Text="{x:Static strings:AppStrings.TutorialSkip}"
                    Style="{StaticResource MatrixGhostButton}"
                    HorizontalOptions="End"
                    Clicked="OnDoneClicked" />

            <CarouselView x:Name="Steps"
                          Grid.Row="1"
                          Loop="False"
                          IndicatorView="Indicators"
                          PositionChanged="OnPositionChanged">
                <CarouselView.ItemTemplate>
                    <DataTemplate x:DataType="local:TutorialStep">
                        <Border Style="{DynamicResource MatrixPanelBorder}" VerticalOptions="Center" Margin="4,0">
                            <VerticalStackLayout Spacing="18">
                                <Label Text="{Binding Emoji}" Style="{DynamicResource MatrixEmoji}" />
                                <Label Text="{Binding Title}" Style="{DynamicResource MatrixSubtitle}" />
                                <Label Text="{Binding Text}" Style="{DynamicResource MatrixBodyCentered}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>

            <IndicatorView x:Name="Indicators" Grid.Row="2" Style="{StaticResource MatrixIndicator}" />

            <Button x:Name="NextButton"
                    Grid.Row="3"
                    Text="{x:Static strings:AppStrings.TutorialNext}"
                    Style="{StaticResource MatrixPrimaryButton}"
                    Clicked="OnNextClicked" />
        </Grid>
    </Grid>

</ContentPage>
