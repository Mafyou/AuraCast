<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Every colour of the app. The palette is sampled from the splash artwork so the two blend:
        a near-black green background, a neon green for what can be tapped, a pale mint for what is read.

        Four build-time files cannot read this dictionary and repeat a value by hand:
        the system splash colour in AuraMusic.Mobile.csproj and Resources/Splash/splash.svg (MatrixBackground),
        Android's theme in Platforms/Android/Resources/values/colors.xml (MatrixBackground, MatrixGreen),
        and the launcher icon background in Resources/AppIcon/appicon.svg (#000B06, the icon artwork's own black).
    -->

    <!-- Surfaces -->
    <Color x:Key="MatrixBackground">#000C08</Color>
    <!-- Panels sit over the rain: almost opaque, so the text on them stays readable. -->
    <Color x:Key="MatrixPanel">#E6020F07</Color>
    <!-- Lets what is behind show through (ghost buttons, the dialog's own window). -->
    <Color x:Key="MatrixClear">Transparent</Color>
    <!-- Dims the page behind a dialog. -->
    <Color x:Key="MatrixOverlay">#B3000000</Color>

    <!-- Text and controls -->
    <Color x:Key="MatrixGreen">#00FF66</Color>
    <Color x:Key="MatrixGreenDim">#1F9E55</Color>
    <Color x:Key="MatrixMint">#D2FFE2</Color>

    <!-- Rain and spectrum: the emerald of the code rain in the artwork, and its bright heads. -->
    <Color x:Key="MatrixEmerald">#00C853</Color>
    <Color x:Key="MatrixHead">#C8FFE0</Color>
    <Color x:Key="MatrixSpectrumLit">#DD00C853</Color>
    <Color x:Key="MatrixSpectrumUnlit">#1400C853</Color>
</ResourceDictionary>
