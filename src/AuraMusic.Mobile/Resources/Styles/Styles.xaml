<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Every component style of the app. Matrix look, tuned for contrast: bright text sits on dark panels,
        the rain stays in the background. Colours come from Colors.xaml.
    -->
    <x:String x:Key="MatrixFont">monospace</x:String>

    <!-- Defaults: anything left unstyled is still readable on the dark background. -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource MatrixBackground}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource MatrixMint}" />
    </Style>

    <!-- Text -->
    <Style x:Key="MatrixTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource MatrixFont}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="TextColor" Value="{StaticResource MatrixGreen}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource MatrixGreen}" Radius="16" Opacity="0.7" Offset="0,0" />
        </Setter>
    </Style>

    <Style x:Key="MatrixSubtitle" TargetType="Label" BasedOn="{StaticResource MatrixTitle}">
        <Setter Property="FontSize" Value="24" />
    </Style>

    <Style x:Key="MatrixStatus" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource MatrixFont}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" Value="{StaticResource MatrixGreen}" />
    </Style>

    <Style x:Key="MatrixBody" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="1.3" />
        <Setter Property="TextColor" Value="{StaticResource MatrixMint}" />
    </Style>

    <Style x:Key="MatrixBodyCentered" TargetType="Label" BasedOn="{StaticResource MatrixBody}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <!-- Small print: the value under a slider, a footnote. -->
    <Style x:Key="MatrixCaption" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource MatrixFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource MatrixGreenDim}" />
    </Style>

    <!-- Terminal-like read-outs of the diagnostics screen. -->
    <Style x:Key="MatrixMono" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource MatrixFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="1.35" />
        <Setter Property="TextColor" Value="{StaticResource MatrixMint}" />
    </Style>

    <Style x:Key="MatrixEmoji" TargetType="Label">
        <Setter Property="FontSize" Value="56" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <!-- Panels -->
    <Style x:Key="MatrixPanelBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource MatrixPanel}" />
        <Setter Property="Stroke" Value="{StaticResource MatrixGreenDim}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 6" />
        <Setter Property="Padding" Value="18,16" />
    </Style>

    <!-- A dialog floats over the dimmed page: opaque, brighter frame, a neon halo. -->
    <Style x:Key="MatrixDialogBorder" TargetType="Border" BasedOn="{StaticResource MatrixPanelBorder}">
        <Setter Property="BackgroundColor" Value="{StaticResource MatrixBackground}" />
        <Setter Property="Stroke" Value="{StaticResource MatrixGreen}" />
        <Setter Property="Padding" Value="20,18" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource MatrixGreen}" Radius="24" Opacity="0.45" Offset="0,0" />
        </Setter>
    </Style>

    <!-- Buttons -->
    <Style x:Key="MatrixButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource MatrixFont}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="HeightRequest" Value="58" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderWidth" Value="2" />
        <Setter Property="BorderColor" Value="{StaticResource MatrixGreen}" />
        <Setter Property="BackgroundColor" Value="{StaticResource MatrixPanel}" />
        <Setter Property="TextColor" Value="{StaticResource MatrixGreen}" />
    </Style>

    <!-- The main action: filled, so it stands out from the outlined ones. -->
    <Style x:Key="MatrixPrimaryButton" TargetType="Button" BasedOn="{StaticResource MatrixButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource MatrixGreen}" />
        <Setter Property="TextColor" Value="{StaticResource MatrixBackground}" />
    </Style>

    <!-- The small buttons in the corners of the home screen. -->
    <Style x:Key="MatrixCornerButton" TargetType="Button" BasedOn="{StaticResource MatrixButton}">
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="MinimumWidthRequest" Value="46" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="VerticalOptions" Value="Start" />
    </Style>

    <!-- The buttons of a dialog. -->
    <Style x:Key="MatrixDialogButton" TargetType="Button" BasedOn="{StaticResource MatrixButton}">
        <Setter Property="HeightRequest" Value="50" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="MatrixDialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource MatrixPrimaryButton}">
        <Setter Property="HeightRequest" Value="50" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="MatrixGhostButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource MatrixFont}" />
        <Setter Property="BackgroundColor" Value="{StaticResource MatrixClear}" />
        <Setter Property="TextColor" Value="{StaticResource MatrixGreenDim}" />
    </Style>

    <!-- Other controls -->
    <Style x:Key="MatrixIndicator" TargetType="IndicatorView">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="IndicatorColor" Value="{StaticResource MatrixGreenDim}" />
        <Setter Property="SelectedIndicatorColor" Value="{StaticResource MatrixGreen}" />
        <Setter Property="IndicatorSize" Value="9" />
    </Style>

    <Style x:Key="MatrixRefresh" TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{StaticResource MatrixGreen}" />
    </Style>

    <Style x:Key="MatrixSlider" TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{StaticResource MatrixGreen}" />
        <Setter Property="MaximumTrackColor" Value="{StaticResource MatrixGreenDim}" />
        <Setter Property="ThumbColor" Value="{StaticResource MatrixMint}" />
    </Style>
</ResourceDictionary>
