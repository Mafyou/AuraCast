<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:AuraMusic.Mobile.Controls"
             xmlns:strings="clr-namespace:AuraMusic.Mobile.Resources.Strings"
             x:Class="AuraMusic.Mobile.MainPage"
             Shell.NavBarIsVisible="False">

    <Grid>
        <controls:MatrixRainView Opacity="0.35" />

        <!-- Pull down to check for a new version. -->
        <RefreshView x:Name="UpdateRefresh" Style="{StaticResource MatrixRefresh}" Refreshing="OnPullToUpdate">
            <!-- RefreshView only reacts on Android when its content can scroll; the layout is sized to the page. -->
            <ScrollView x:Name="HomeScroll" VerticalScrollBarVisibility="Never" SafeAreaEdges="Container">
                <Grid x:Name="HomeLayout" RowDefinitions="*,Auto,Auto" Padding="20,40,20,28" RowSpacing="12">

                    <Button x:Name="LanguageButton"
                            Style="{StaticResource MatrixCornerButton}"
                            HorizontalOptions="Start"
                            SemanticProperties.Description="{x:Static strings:AppStrings.SwitchLanguageDescription}"
                            Clicked="OnLanguageClicked" />

                    <Button Text="?"
                            Style="{StaticResource MatrixCornerButton}"
                            HorizontalOptions="End"
                            SemanticProperties.Description="{x:Static strings:AppStrings.HelpDescription}"
                            Clicked="OnHelpClicked" />

                    <VerticalStackLayout VerticalOptions="Center" Spacing="18">
                        <!-- Double-tap for the diagnostics screen. -->
                        <Image Source="splash_screen.png"
                               HeightRequest="300"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               SemanticProperties.Description="AuraMusic"
                               SemanticProperties.HeadingLevel="Level1">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="OnArtworkDoubleTapped" />
                            </Image.GestureRecognizers>
                        </Image>

                        <Border Style="{StaticResource MatrixPanelBorder}">
                            <VerticalStackLayout Spacing="8">
                                <Label x:Name="StatusLabel" Style="{StaticResource MatrixStatus}" />
                                <Label x:Name="HintLabel" Style="{StaticResource MatrixBody}" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ModeButtons" Grid.Row="1" Spacing="12">
                        <Button Text="{x:Static strings:AppStrings.BroadcastButton}"
                                Style="{StaticResource MatrixPrimaryButton}"
                                Clicked="OnBroadcastClicked" />

                        <Button Text="{x:Static strings:AppStrings.ListenButton}"
                                Style="{StaticResource MatrixButton}"
                                Clicked="OnListenClicked" />
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ActivePanel" Grid.Row="2" Spacing="12">
                        <controls:SpectrumView x:Name="Spectrum" HeightRequest="120" />

                        <!-- Listening only: how much audio to keep in hand. Left is closer to the master's own sound. -->
                        <Grid x:Name="SyncPanel" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                            <Slider x:Name="SyncSlider"
                                    Grid.ColumnSpan="3"
                                    Style="{StaticResource MatrixSlider}"
                                    SemanticProperties.Description="{x:Static strings:AppStrings.SyncDescription}"
                                    ValueChanged="OnSyncChanged" />
                            <Label Grid.Row="1" Text="{x:Static strings:AppStrings.SyncCloser}" Style="{StaticResource MatrixCaption}" />
                            <Label x:Name="SyncLabel" Grid.Row="1" Grid.Column="1" Style="{StaticResource MatrixCaption}" HorizontalTextAlignment="Center" />
                            <Label Grid.Row="1" Grid.Column="2" Text="{x:Static strings:AppStrings.SyncSteadier}" Style="{StaticResource MatrixCaption}" />
                        </Grid>

                        <Button Text="{x:Static strings:AppStrings.StopButton}"
                                Style="{StaticResource MatrixButton}"
                                Clicked="OnStopClicked" />
                    </VerticalStackLayout>
                </Grid>
            </ScrollView>
        </RefreshView>

        <!-- Shown for 2 s at launch: Android 12+ only allows a tiny icon on the system splash. -->
        <Grid x:Name="SplashOverlay" BackgroundColor="{StaticResource MatrixBackground}">
            <Image Source="splash_screen.png"
                   Aspect="AspectFit"
                   Margin="20"
                   SemanticProperties.Description="{x:Static strings:AppStrings.LogoDescription}" />
            <!-- Which version is running, readable at a glance while the artwork shows. -->
            <Label x:Name="VersionLabel"
                   Style="{StaticResource MatrixCaption}"
                   HorizontalOptions="Center"
                   VerticalOptions="End"
                   Margin="0,0,0,28" />
        </Grid>
    </Grid>

</ContentPage>
